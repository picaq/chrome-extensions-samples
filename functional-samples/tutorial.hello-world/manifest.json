{
  "name": "Audio File Fix",
  "description": "Fix audio file playing issues in old websites",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "hello.html",
    "default_icon": "hello_extensions.png"
  },
  "content_scripts": [
    {
      "js": ["conversion.js"],
      "css": ["styles.css"],
      "matches": [
        "https://cantonese.ca/*",
        "https://web.uvic.ca/lancenrd/indonesian/*"
      ],
      "all_frames": true
    }
  ]
}
